[Unit]
Description=Finder Candles Mini App backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/candels/pattern_finder
ExecStart=/root/candels/pattern_finder/.venv/bin/python mini_app.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/candels/pattern_finder

[Install]
WantedBy=multi-user.target
