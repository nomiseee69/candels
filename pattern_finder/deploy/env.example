# Секреты бота. Этот файл НЕ попадает в git (.env есть в .gitignore).
TELEGRAM_TOKEN=вставь_токен_от_BotFather
TELEGRAM_CHAT_ID=твой_chat_id
# Если api.telegram.org не открывается (блокировка у провайдера) — прокси для Telegram:
# TELEGRAM_PROXY=http://адрес:порт

# --- подписка (обновление 40) ---
# Админы — всегда Pro, получают уведомления об ошибках и оплатах, команды /admin /grant …
# (по умолчанию — TELEGRAM_CHAT_ID). Несколько — через запятую.
# ADMIN_IDS=123456789
# Цены. Звёзды: пользователь платит ≈ $10 за 500 ⭐ (курс звёзд у Telegram меняется — проверь).
# STARS_MONTH=500
# STARS_YEAR=4800
# RUB_MONTH=990
# RUB_YEAR=9490
# TRIAL_DAYS=3   (0 — без пробного периода)
# ЮKassa (оплата картой РФ / СБП). Нет ключей — кнопок оплаты картой нет, только звёзды.
# YOOKASSA_SHOP_ID=123456
# YOOKASSA_SECRET_KEY=live_xxx
# YOOKASSA_RETURN_URL=https://t.me/имя_твоего_бота
# Сколько сканов пользователей выполнять одновременно (остальные ждут в очереди)
# MAX_PARALLEL_SCANS=2

# MINI_APP_URL=https://mini.example.invalid/
# MINI_APP_PROFILE_ENABLED=0
# MINI_APP_AFFILIATE_ACTIVE=0

# Finder Candles Partners. Manual TON payouts, only after a reviewed cutover.
REFERRALS_ENABLED=0
REFERRAL_PAYOUTS_ENABLED=0
REFERRAL_TEST_MODE=0
# UTC Unix time of verified native program termination; wait 32 days before enabling.
# REFERRAL_NATIVE_ENDED_AT=
REFERRAL_COMMISSION_PERCENT=10
MINIMUM_PAYOUT_USDT=10
REFERRAL_HOLD_DAYS=21
REFERRAL_PAYOUT_INTERVAL_DAYS=7
WALLET_CHANGE_COOLDOWN_HOURS=48
PAYOUT_NETWORK=TON_MAINNET
USDT_TON_MASTER_ADDRESS=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
TON_CONNECT_MANIFEST_URL=https://findercandles.duckdns.org/tonconnect-manifest.json
TON_CONNECT_APP_DOMAIN=findercandles.duckdns.org
TON_API_PROVIDER_URL=https://tonapi.io
