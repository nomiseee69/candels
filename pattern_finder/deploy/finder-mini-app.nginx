# Replace the placeholder after the domain and TLS certificate are ready.
server {
    listen 443 ssl;
    server_name mini.example.invalid;
    ssl_certificate /etc/letsencrypt/live/mini.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mini.example.invalid/privkey.pem;

    client_max_body_size 4k;
    client_header_timeout 10s;
    client_body_timeout 10s;

    location = /api/partners/verify {
        client_max_body_size 24k;
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }

    location = /api/owner-wallets/verify {
        client_max_body_size 24k;
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }
}
